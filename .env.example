# Provider API keys — copy to .env.local (gitignored, chmod 600) and fill in
# the providers you use. Or run the guided setup + validation:
#   npx llm-gateway init
#   npx llm-gateway doctor
#
# Resolution order: ProviderConfig.apiKeys (programmatic) > shell env >
# .env.local > .env. Production keys belong in your deploy platform's
# secret store, not in files.

ANTHROPIC_API_KEY=        # console.anthropic.com → API keys (sk-ant-...)
OPENAI_API_KEY=           # platform.openai.com/api-keys (sk-...)
GOOGLE_API_KEY=           # aistudio.google.com/apikey (AI Studio, not Vertex)
OPENROUTER_API_KEY=       # openrouter.ai/keys (sk-or-...)
VENICE_API_KEY=           # venice.ai/settings/api
TOGETHER_API_KEY=         # api.together.ai/settings/api-keys
HF_TOKEN=                 # huggingface.co/settings/tokens (hf_..., Inference permission)

# Local endpoints (Ollama / vLLM / LM Studio) need no keys — localhost
# presets work zero-config; custom endpoints are configured in code via
# ProviderConfig.endpoints (apiKeyEnv can point at any var you add here).
